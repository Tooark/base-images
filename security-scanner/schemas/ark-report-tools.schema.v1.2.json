{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tooark:schemas:ark-report-tools:1.2",
  "title": "ark-report-tools",
  "description": "Envelope padronizado para relatórios gerados pelas imagens da família ark-* (security-scanner, iac-scanner, trivy-hadolint).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "version",
    "timestamp",
    "command",
    "target",
    "tool",
    "report"
  ],
  "properties": {
    "schema": {
      "const": "ark-report-tools",
      "description": "Identificador fixo do envelope."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Versão do envelope (ex.: 1.2)."
    },
    "image_family": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "security-scanner",
        "iac-scanner",
        "trivy-hadolint",
        "unknown",
        null
      ],
      "description": "Família/imagem que gerou o relatório. Útil para roteamento e analytics."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Momento da geração do relatório (ISO 8601 UTC)."
    },
    "command": {
      "type": "string",
      "enum": [
        "image-scan",
        "filesystem-scan",
        "config-scan",
        "repo-scan",
        "dockerfile-lint",
        "secret-scan",
        "full-scan",
        "terraform-scan",
        "kubernetes-scan",
        "cloudformation-scan",
        "checkov-scan",
        "kics-scan",
        "terrascan-scan",
        "tflint-scan",
        "yaml-lint"
      ],
      "description": "Comando do ark-tools que gerou o relatório."
    },
    "target": {
      "type": "string",
      "description": "Alvo do scan (imagem:tag, path local ou URL de repositório)."
    },
    "tool": {
      "type": "string",
      "description": "Ferramenta ou combinação (ex.: 'trivy', 'betterleaks', 'trivy+hadolint+betterleaks', 'checkov+tflint+yamllint')."
    },
    "sbom_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Indica se SBOM foi gerado."
    },
    "list_all_pkgs": {
      "type": "boolean",
      "default": false,
      "description": "Indica se Trivy foi executado com --list-all-pkgs (inventário completo)."
    },
    "metadata": {
      "type": "object",
      "description": "Metadados de SCM/CI coletados na execução.",
      "additionalProperties": true,
      "properties": {
        "scm": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "branch": {
              "type": [
                "string",
                "null"
              ]
            },
            "commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{7,40}$"
            },
            "commit_short": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-fA-F]{7,12}$"
            },
            "repository": {
              "type": [
                "string",
                "null"
              ]
            },
            "tag": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "ci": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "platform": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "gitlab",
                "github",
                "azure",
                "bitbucket",
                "jenkins",
                null,
                ""
              ]
            },
            "user": {
              "type": [
                "string",
                "null"
              ]
            },
            "pipeline_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "job_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "scan_context": {
          "type": "object",
          "description": "Contexto adicional (preenchido por comandos compostos como full-scan).",
          "additionalProperties": true,
          "properties": {
            "scan_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "scan_mode": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "fs",
                "repo",
                null,
                ""
              ]
            },
            "dockerfiles": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "report": {
      "description": "Payload bruto da ferramenta. Estrutura varia por ferramenta e versão.",
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "results": {
      "description": "Apenas para command=full-scan — agrega sub-relatórios.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "full-scan"
          }
        }
      },
      "then": {
        "required": [
          "results"
        ],
        "properties": {
          "results": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "image_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "source_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "secret_scan": {
                "type": [
                  "object",
                  "array",
                  "null"
                ]
              },
              "dockerfile_lints": {
                "type": [
                  "array",
                  "null"
                ]
              },
              "terraform_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "kubernetes_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "kics_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "terrascan_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "tflint_scan": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "yaml_lint": {
                "type": [
                  "object",
                  "array",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
