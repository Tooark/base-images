# Versões centralizadas das imagens base e ferramentas

# Define a imagem base usada em todos os Dockerfiles.
BASE_IMAGE=debian:12-slim

# Versão do AWS CLI v2 (consultar https://raw.githubusercontent.com/aws/aws-cli/v2/CHANGELOG.rst)
AWSCLI_VERSION=2.34.33

# Versão do Google Cloud SDK (consultar https://cloud.google.com/sdk/docs/release-notes)
GCLOUD_VERSION=565.0.0

# Versão do kubectl (consultar https://kubernetes.io/releases/)
KUBECTL_VERSION=1.35.4

# Versão do Terraform (consultar https://releases.hashicorp.com/terraform/)
TERRAFORM_VERSION=1.14.9

# Versão do Trivy (consultar https://github.com/aquasecurity/trivy/releases)
TRIVY_VERSION=0.70.0

# Versão do Hadolint (consultar https://github.com/hadolint/hadolint/releases)
HADOLINT_VERSION=2.14.0

# Versão para tags de imagem de terraform com AWS CLI
TF_AWS_VERSION=1.1.0

# Versão para tags de imagem de terraform com Google Cloud SDK
TF_GCLOUD_VERSION=2.0.0

# Versão para tags de imagem de terraform com AWS CLI e Google Cloud SDK
TF_AWS_GCLOUD_VERSION=2.0.0

# Versão para tags de imagem de trivy e hadolint
TRIVY_HADOLINT_VERSION=1.68.0
