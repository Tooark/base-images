# Versões centralizadas das imagens base e ferramentas

# Define a imagem base usada em todos os Dockerfiles.
BASE_IMAGE=debian:13-slim

# Versão do AWS CLI v2 (consultar https://raw.githubusercontent.com/aws/aws-cli/v2/CHANGELOG.rst)
AWSCLI_VERSION=2.35.15

# Versão do Google Cloud SDK (consultar https://cloud.google.com/sdk/docs/release-notes)
GCLOUD_VERSION=575.0.0

# Versão do kubectl (consultar https://kubernetes.io/releases/)
KUBECTL_VERSION=1.36.2

# Versão do Terraform legada (mantida congelada para compatibilidade)
TERRAFORM_VERSION=1.15.7

# Versão do OpenTofu (consultar https://github.com/opentofu/opentofu/releases)
OPENTOFU_VERSION=1.12.3

# Versão do Trivy (consultar https://github.com/aquasecurity/trivy/releases)
TRIVY_VERSION=0.72.0

# Versão do Hadolint (consultar https://github.com/hadolint/hadolint/releases)
HADOLINT_VERSION=2.14.0

# Versão do Sonar Scanner CLI (consultar https://github.com/SonarSource/sonar-scanner-cli/releases)
SONAR_CLI_VERSION=8.1.0.6389

# Versão do Docker CLI (consultar https://github.com/docker/cli/releases)
DOCKER_VERSION=29.6.1

# Versão do Docker Buildx plugin (consultar https://github.com/docker/buildx/releases)
DOCKER_BUILDX_VERSION=0.35.0

# Versão do Betterleaks (consultar https://github.com/betterleaks/betterleaks/releases)
BETTERLEAKS_VERSION=1.6.1

# Versão para tags de imagem de terraform com AWS CLI
TF_AWS_VERSION=1.3.5

# Versão para tags de imagem de OpenTofu com AWS CLI
TOFU_AWS_VERSION=1.0.3

# Versão para tags de imagem de terraform com Google Cloud SDK
TF_GCLOUD_VERSION=12.0.1

# Versão para tags de imagem de OpenTofu com Google Cloud SDK
TOFU_GCLOUD_VERSION=2.0.1

# Versão para tags de imagem de terraform com AWS CLI e Google Cloud SDK
TF_AWS_GCLOUD_VERSION=12.0.2

# Versão para tags de imagem de OpenTofu com AWS CLI e Google Cloud SDK
TOFU_AWS_GCLOUD_VERSION=2.0.2

# Versão para tags de imagem de trivy e hadolint
TRIVY_HADOLINT_VERSION=1.73.1

# Versão para tags de imagem Docker CLI e Buildx
DOCKERX_VERSION=29.2.2

# Versão para tags de imagem de segurança com Trivy + Betterleaks + Hadolint
SECURITY_SCANNER_VERSION=1.4.1
